---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EntryTimeline from '../../components/EntryTimeline.astro';
import EntryList from '../../components/EntryList.astro';
import { COLLECTIONS, entriesOf, recent } from '../../lib/entries';

export async function getStaticPaths() {
  return COLLECTIONS.map((c) => ({ params: { collection: c.name }, props: { meta: c } }));
}

const { meta } = Astro.props;
const entries = await entriesOf(meta.name);
const fresh = recent(entries, 30);
/** 部署方案按类型分组比按月份分组更好用 */
const kinds = meta.name === 'deploy' ? [...new Set(entries.map((e) => e.kind).filter(Boolean))] : [];
---

<BaseLayout title={meta.label} description={`${meta.desc}｜共 ${entries.length} 条收录`}>
  <h1 class="page-title">{meta.label}</h1>
  <p class="page-desc">
    {meta.desc}。共 {entries.length} 条，其中 {fresh.length} 条是最近 30 天发布的。
  </p>

  {
    kinds.length > 0 ? (
      kinds.map((kind) => (
        <section class="section">
          <h2>{kind}</h2>
          <EntryList entries={entries.filter((e) => e.kind === kind)} />
        </section>
      ))
    ) : (
      <EntryTimeline entries={entries} />
    )
  }
</BaseLayout>