---
import { getCollection } from 'astro:content';
import EntryDetail from '../../components/EntryDetail.astro';
import type { CollectionName } from '../../lib/entries';

export async function getStaticPaths() {
  const items = await getCollection('projects');
  return items.map((entry) => ({
    params: { slug: entry.id },
    props: { collection: 'projects' as CollectionName, entry },
  }));
}

const { collection, entry } = Astro.props;
---

<EntryDetail collection={collection} entry={entry} />