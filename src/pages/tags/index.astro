---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { allEntries, tagCounts } from '../../lib/entries';

const entries = await allEntries();
const tags = tagCounts(entries);
---

<BaseLayout title="标签" description="按标签浏览收录的开源模型与部署方案">
  <h1 class="page-title">标签</h1>
  <p class="page-desc">共 {tags.length} 个标签。标签是这套收录体系里唯一的"弱分类"，用来横切板块。</p>

  <div class="tags" style="margin-left:0">
    {
      tags.map((t) => (
        <a class="tag" href={`/tags/${encodeURIComponent(t.tag)}/`}>
          #{t.tag} · {t.count}
        </a>
      ))
    }
  </div>
</BaseLayout>