---
import BaseLayout from '../layouts/BaseLayout.astro';
import EntryList from '../components/EntryList.astro';
import { allEntries, releasedWithinDays } from '../lib/entries';

/**
 * 首页看「最近 30 天出了什么」：按 LLM / AIGC 分开，各列出窗口内（最近 30 个日历天）
 * 发布的条目，直接平铺、按发布时间倒序；不再按月份拆小节，也不显示月份日期。
 *
 * 分区标题本身就是入口：点 **LLM 近期模型** 进 /llm/models/、点 **AIGC 近期模型** 进 /aigc/image/
 * （与顶部导航"直接点 AIGC 打开生图"一致）。
 */
const HOME_WINDOW_DAYS = 30;
const entries = await allEntries();

const sections = [
  {
    title: 'LLM 近期模型',
    link: '/llm/models/',
    hint: '看全部 LLM 模型',
    empty: '最近 30 天还没有新的 LLM。',
    pool: entries.filter((e) => e.collection === 'llm'),
  },
  {
    title: 'AIGC 近期模型',
    link: '/aigc/image/',
    hint: '看全部生图模型（生视频在顶部 AIGC 菜单里）',
    empty: '最近 30 天还没有新的 AIGC 模型。',
    pool: entries.filter((e) => e.collection === 'aigc'),
  },
].map((s) => ({
  ...s,
  items: releasedWithinDays(s.pool, HOME_WINDOW_DAYS),
}));
---

<BaseLayout title="首页">
  {
    sections.map((section) => (
      <section class="section home-section">
        <h2 class="home-title">
          <a href={section.link} title={section.hint}>
            {section.title}
            <span class="fact">{section.items.length}</span>
            <span class="home-arrow" aria-hidden="true">
              →
            </span>
          </a>
        </h2>
        <EntryList
          entries={section.items}
          variant="model"
          empty={section.empty}
        />
      </section>
    ))
  }
</BaseLayout>
