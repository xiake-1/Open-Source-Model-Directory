---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_TITLE } from '../lib/site';

const entries = [
  { href: '/llm/models/', label: 'LLM · 开源模型', desc: '开放权重、可自部署的语言模型，按时间排。' },
  { href: '/llm/github/', label: 'LLM · 社区项目', desc: '社区围绕开源模型做的各种方案。' },
  { href: '/llm/deploy/', label: 'LLM · 部署方式', desc: '本地部署 LLM 的工具与框架，按方案大类分组。' },
  { href: '/aigc/image/', label: 'AIGC · 生图', desc: '开放权重的图像生成模型。' },
  { href: '/aigc/video/', label: 'AIGC · 生视频', desc: '开放权重的视频生成模型。' },
];
---

<BaseLayout title="关于" description={`${SITE_TITLE} 是什么`}>
  <h1 class="page-title">关于</h1>

  <div class="prose">
    <p>
      网站链接：<a href="https://omdir.de5.net/">https://omdir.de5.net/</a> QQ交流群：<span class="qq-group">1128481543</span>
    </p>

    <p>
      新模型和围绕它们冒出来的工具实在太多，链接散在收藏夹和聊天记录里，过一阵就找不到了。
      这里把它们压成同一种格式：<strong>官方链接 + 发布时间 + 一句话简介</strong>，
      再按时间线排好。打开首页就能看到这个月出了什么。
    </p>

    <h2>站内有什么</h2>
    <ul>
      {
        entries.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a> —— {item.desc}
          </li>
        ))
      }
    </ul>

    <h2>怎么读</h2>
    <ul>
      <li><strong>时间</strong>：以官方首次公开发布为准，按"年-月"分组，同一月里新的排在前面。</li>
      <li><strong>标签</strong>：LLM 只分"结构（MoE / Dense）"和"类型（纯文本 / 可识别图像）"；AIGC 只分架构。列表页左侧可以按标签筛。</li>
      <li><strong>链接</strong>：每一条至少给一个官方入口，优先 HuggingFace 与 GitHub。</li>
      <li><strong>收录标准</strong>：只收开放权重、能自己部署的模型，以及和 LLM 相关的部署工具；只有 API 的闭源服务不收。</li>
    </ul>

    <h2>说明</h2>
    <p>
      整站是纯静态的，内容就是仓库里的 Markdown 文件，一个条目一个文件，字段写错会让构建直接失败。
      本站只存链接和一句话简介，不镜像任何权重和代码；模型、代码、商标版权归原作者所有。
    </p>
  </div>
</BaseLayout>