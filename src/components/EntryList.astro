---
import type { Entry } from '../lib/entries';
import EntryCard from './EntryCard.astro';

interface Props {
  entries: Entry[];
  variant?: 'model' | 'project' | 'deploy';
  empty?: string;
  /** 标签小胶囊要跳去的列表页路径 */
  tagBase?: string;
}

const { entries, variant = 'model', empty = '这里还没有条目。', tagBase } = Astro.props;
---

{
  entries.length === 0 ? (
    <p class="page-desc">{empty}</p>
  ) : (
    <div class="cards">
      {entries.map((entry) => (
        <EntryCard entry={entry} variant={variant} tagBase={tagBase} />
      ))}
    </div>
  )
}