---
import type { Entry } from '../lib/entries';
import { groupByMonth, monthKeyLabel } from '../lib/entries';
import EntryList from './EntryList.astro';

interface Props {
  entries: Entry[];
  variant?: 'model' | 'project' | 'deploy';
  /** 列表为空时的提示 */
  empty?: string;
  /** 标签小胶囊要跳去的列表页路径 */
  tagBase?: string;
}

const { entries, variant = 'model', empty = '这里还没有条目。', tagBase } = Astro.props;
const groups = groupByMonth(entries);
---

{
  groups.length === 0 ? (
    <p class="page-desc">{empty}</p>
  ) : (
    groups.map((group) => (
      <section class="section month" data-month={group.key}>
        <h2>
          {monthKeyLabel(group.key)} <span class="fact">{group.items.length}</span>
        </h2>
        <EntryList entries={group.items} variant={variant} tagBase={tagBase} />
      </section>
    ))
  )
}