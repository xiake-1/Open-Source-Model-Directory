---
import type { Entry } from '../lib/entries';
import { COLLECTION_LABELS } from '../lib/entries';
import { formatDate, LINK_LABELS, STATUS_LABELS } from '../lib/format';

interface Props {
  entry: Entry;
  /** 跨集合列表（首页 / 标签 / 近期）需要标出它属于哪个板块 */
  showCollection?: boolean;
}

const { entry, showCollection = false } = Astro.props;
const links = Object.entries(entry.links).filter(([, url]) => Boolean(url)) as [string, string][];
const released = formatDate(entry.released);
---

<article class="entry" data-status={entry.status} data-released={released}>
  <div class="entry-head">
    <a class="entry-title" href={entry.href}>{entry.title}</a>
    {showCollection && <span class="badge badge-cat">{COLLECTION_LABELS[entry.collection]}</span>}
    <span class="entry-org">{entry.org}</span>
    <time class="entry-time" datetime={released} data-relative title={`发布：${released}`}>{released}</time>
  </div>

  <p class="entry-summary">{entry.summary}</p>

  {
    entry.facts.length > 0 && (
      <div class="entry-facts">
        {entry.facts.map((fact) => (
          <span class="fact">{fact}</span>
        ))}
      </div>
    )
  }

  <div class="entry-foot">
    <span class="links">
      {
        links.map(([key, url]) => (
          <a href={url} target="_blank" rel="noopener noreferrer">
            {LINK_LABELS[key] ?? key} ↗
          </a>
        ))
      }
    </span>
    {entry.status !== 'active' && <span class="badge badge-dead">{STATUS_LABELS[entry.status]}</span>}
    {
      entry.tags.length > 0 && (
        <span class="tags">
          {entry.tags.map((tag) => (
            <a class="tag" href={`/tags/${encodeURIComponent(tag)}/`}>
              #{tag}
            </a>
          ))}
        </span>
      )
    }
  </div>
</article>