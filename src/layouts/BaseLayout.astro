---
import '../styles/global.css';
import { SITE_TITLE, SITE_DESC } from '../lib/site';

interface Props {
  title: string;
  description?: string;
}

const { title, description = SITE_DESC } = Astro.props;
const path = Astro.url.pathname;
const canonical = Astro.site ? new URL(path, Astro.site).href : path;
const fullTitle = title === '首页' ? SITE_TITLE : `${title} · ${SITE_TITLE}`;

/** 顶部只保留四项：首页 / LLM / AIGC / 关于。LLM 与 AIGC 悬停出子选项。 */
const nav = [
  { href: '/', label: '首页', children: [] as { href: string; label: string; desc: string }[] },
  {
    href: '/llm/models/',
    label: 'LLM',
    children: [
      { href: '/llm/models/', label: '开源模型', desc: '按时间看新出的开放权重模型' },
      { href: '/llm/github/', label: '社区项目', desc: '社区围绕开源模型做的方案' },
      { href: '/llm/deploy/', label: '部署方式', desc: '本地部署工具，按方案大类分组' },
    ],
  },
  {
    href: '/aigc/image/',
    label: 'AIGC',
    children: [
      { href: '/aigc/image/', label: '生图', desc: '图像生成模型' },
      { href: '/aigc/video/', label: '生视频', desc: '视频生成模型' },
    ],
  },
  { href: '/about/', label: '关于', children: [] as { href: string; label: string; desc: string }[] },
];
/** 父项高亮：子页面里只要路径对得上就点亮父级菜单 */
const inSection = (href: string) => (href === '/' ? path === '/' : path.startsWith(href.split('/').slice(0, 2).join('/') + '/'));
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href="/rss.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <script is:inline>
      // 在首次绘制前定好主题，避免深色用户看到一闪而过的白屏。
      // 没有手动选择过时跟随系统（CSS 里的 prefers-color-scheme 负责）。
      try {
        var saved = localStorage.getItem('theme');
        if (saved === 'dark' || saved === 'light') {
          document.documentElement.setAttribute('data-theme', saved);
        }
      } catch (err) {
        /* 隐私模式下 localStorage 可能不可用，忽略即可 */
      }
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="brand" href="/">{SITE_TITLE}</a>
        <nav class="site-nav">
          {
            nav.map((item) => (
              <div class="nav-item" data-has-menu={item.children.length > 0 ? 'true' : undefined}>
                <a
                  class={item.children.length > 0 ? 'nav-parent' : undefined}
                  href={item.href}
                  aria-current={path === item.href ? 'page' : undefined}
                  data-active={inSection(item.href) ? 'true' : undefined}
                >
                  {item.label}
                </a>
                {item.children.length > 0 && (
                  <div class="nav-menu">
                    {item.children.map((child) => (
                      <a href={child.href} aria-current={path === child.href ? 'page' : undefined}>
                        <span class="nm-label">{child.label}</span>
                        <span class="nm-desc">{child.desc}</span>
                      </a>
                    ))}
                  </div>
                )}
              </div>
            ))
          }
        </nav>
        <div class="search">
          <input
            id="site-search"
            type="search"
            placeholder="搜索模型 / 项目 / 方案…"
            autocomplete="off"
            aria-label="站内搜索"
          />
          <div class="search-results" id="search-results" data-open="false"></div>
        </div>
        <button id="theme-toggle" class="theme-toggle" type="button" aria-label="切换深色 / 浅色" title="切换深色 / 浅色">
          <span class="tt-icon" data-theme-icon></span>
        </button>
      </div>
    </header>

    <main class="wrap">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <span>© {new Date().getFullYear()} {SITE_TITLE}</span>
        <a href="/rss.xml">RSS 订阅</a>
        <a href="/about/">关于本站</a>
        <span>本站只存链接与简介，模型与代码版权归原作者所有</span>
      </div>
    </footer>

    <script is:inline>
      // 1) 相对时间：静态站不会天天重建，所以"3 天前"在浏览器里算，不写死在 HTML 里
      const rtf = new Intl.RelativeTimeFormat('zh-CN', { numeric: 'auto' });
      const toDays = (iso) => Math.floor((Date.now() - new Date(iso + 'T00:00:00Z').getTime()) / 86400000);
      const humanize = (days) => {
        if (days <= 0) return '今天';
        if (days === 1) return '昨天';
        if (days < 30) return `${days} 天前`;
        if (days < 365) return rtf.format(-Math.round(days / 30), 'month');
        return rtf.format(-Math.floor(days / 365), 'year');
      };
      for (const el of document.querySelectorAll('time[data-relative]')) {
        const iso = el.getAttribute('datetime');
        if (iso) el.textContent = humanize(toDays(iso));
      }
      // 2) NEW 标记：最近 14 天发布的条目自动加角标
      for (const card of document.querySelectorAll('.entry[data-released]')) {
        const days = toDays(card.getAttribute('data-released'));
        if (days < 0 || days > 14) continue;
        const title = card.querySelector('.entry-title');
        if (!title || card.querySelector('.badge-new')) continue;
        const badge = document.createElement('span');
        badge.className = 'badge badge-new';
        badge.textContent = 'NEW';
        title.insertAdjacentElement('afterend', badge);
      }
      // 3) 站内搜索：索引在首次输入时才拉取，列表页保持零请求
      const input = document.getElementById('site-search');
      const box = document.getElementById('search-results');
      let index = null;
      const loadIndex = async () => {
        if (!index) index = await fetch('/search.json').then((r) => r.json());
        return index;
      };
      // 结果里的字段来自你自己的 Markdown，但一律转义，避免标题里带 HTML 时被注入
      const esc = (s) =>
        String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]);
      const score = (item, q) => {
        const t = item.t.toLowerCase();
        const o = item.o.toLowerCase();
        if (t.startsWith(q)) return 100;
        if (t.includes(q)) return 80;
        if (o.includes(q)) return 60;
        if (item.g.some((g) => g.toLowerCase().includes(q))) return 40;
        if (item.s.toLowerCase().includes(q)) return 20;
        if (item.b && item.b.toLowerCase().includes(q)) return 5;
        return 0;
      };
      const render = (hits) => {
        if (!hits.length) {
          box.innerHTML = '<div class="sr-empty">没有匹配的条目</div>';
        } else {
          // 结果一律在新窗口打开：搜索常常是在列表页上进行的，别把当前列表顶掉
          box.innerHTML = hits
            .map(
              (h) =>
                `<a href="${esc(h.h)}" target="_blank" rel="noopener"><div class="sr-title">${esc(h.t)}</div><div class="sr-meta">${esc(h.c)} · ${esc(h.o)} · ${esc(h.d)}</div></a>`
            )
            .join('');
        }
        box.dataset.open = 'true';
      };
      if (input && box) {
        input.addEventListener('input', async () => {
          const q = input.value.trim().toLowerCase();
          if (!q) {
            box.dataset.open = 'false';
            return;
          }
          const data = await loadIndex();
          const hits = data
            .map((item) => ({ item, s: score(item, q) }))
            .filter((x) => x.s > 0)
            .sort((a, b) => b.s - a.s)
            .slice(0, 20)
            .map((x) => x.item);
          render(hits);
        });
        input.addEventListener('focus', () => {
          if (input.value.trim()) box.dataset.open = 'true';
        });
        document.addEventListener('click', (e) => {
          if (e.target !== input && !box.contains(e.target)) box.dataset.open = 'false';
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') box.dataset.open = 'false';
        });
      }
      // 4) 深色 / 浅色开关：手动选择写进 localStorage，覆盖系统偏好
      const themeToggle = document.getElementById('theme-toggle');
      const themeIcon = themeToggle && themeToggle.querySelector('[data-theme-icon]');
      const systemDark = () => window.matchMedia('(prefers-color-scheme: dark)').matches;
      const currentTheme = () => {
        const set = document.documentElement.getAttribute('data-theme');
        if (set === 'dark' || set === 'light') return set;
        return systemDark() ? 'dark' : 'light';
      };
      const paintIcon = () => {
        if (themeIcon) themeIcon.textContent = currentTheme() === 'dark' ? '☾' : '☀';
      };
      if (themeToggle) {
        paintIcon();
        themeToggle.addEventListener('click', () => {
          const next = currentTheme() === 'dark' ? 'light' : 'dark';
          document.documentElement.setAttribute('data-theme', next);
          try {
            localStorage.setItem('theme', next);
          } catch (err) {
            /* 忽略：不能持久化也能用 */
          }
          paintIcon();
        });
      }
    </script>
  </body>
</html>